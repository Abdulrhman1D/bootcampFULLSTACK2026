@model Appointment
@{
    ViewData["Title"] = "Edit Appointment";
}


<div class="container">
    <h1>Edit Appointment</h1>
    <form asp-action="Edit" method="post">

        <div class="text-danger" asp-validation-summary="All">
        </div>
       

        <div class="form-group">
            <label asp-for="PatientId">Patient</label>
            <select asp-for="PatientId"
                    asp-items="ViewBag.Patients"
                    class="form-control">
            </select>

        </div>
        <div class="form-group">
            <label asp-for="DoctorId">Doctor</label>
            <select asp-for="DoctorId"
                    asp-items="ViewBag.Doctors"
                    class="form-control">
            </select>
        </div>
        <div class="form-group">
            <label asp-for="AppointmentDate">Appointment Date</label>
            <input asp-for="AppointmentDate"
                   type="datetime-local"
                   class="form-control" />
        </div>
        <div class="form-group">
            <label asp-for="Status" class="control-label"></label>
            <textarea asp-for="Status" class="form-control"></textarea>
            <span class="text-danger" asp-validation-for="Status"></span>
        </div>
        <div class="form-group">
            <label asp-for="Notes" class="control-label"></label>
            <textarea asp-for="Notes" class="form-control"></textarea>
            <span class="text-danger" asp-validation-for="Notes"></span>
        </div>

        

        <div class="form-group">
            <input type="submit" value="Update" class="btn btn-warning" />
        </div>
    </form>
    <div>
        <a asp-action="Index">Back to List</a>
    </div>
</div>
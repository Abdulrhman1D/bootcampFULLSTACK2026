@model Appointment
@{
    ViewData["Title"] = "Delete Appointment";
}


<div class="container">
    <h1>Delete Appointment</h1>
    <form asp-action="Delete" method="post">

       

        <div class="form-group">
            <label>Patient</label>
            <input value="@Model.Patient?.Name" class="form-control" readonly />
        </div>

        <div class="form-group">
            <label>Doctor</label>
            <input value="@Model.Doctor?.Name" class="form-control" readonly />
        </div>
        <div class="form-group">
            <label>Appointment Date</label>
            <input value="@Model.AppointmentDate"
                   class="form-control"
                   readonly />
        </div>
        <div class="form-group">
            <label asp-for="Status" class="control-label"></label>
            <textarea asp-for="Status" class="form-control" readonly></textarea>
            <span class="text-danger" asp-validation-for="Status"></span>
        </div>
        <div class="form-group">
            <label asp-for="Notes" class="control-label"></label>
            <textarea asp-for="Notes" class="form-control" readonly></textarea>
            <span class="text-danger" asp-validation-for="Notes"></span>
        </div>
        


        <div class="form-group">
            <input type="submit" value="Delete" class="btn btn-danger" />
        </div>
    </form>
    <div>
        <a asp-action="Index">Back to List</a>
    </div>
</div>
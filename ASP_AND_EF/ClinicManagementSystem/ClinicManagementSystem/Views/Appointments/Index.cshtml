@model IEnumerable<Appointment>
<div class="container">
    <h2>Appointments</h2>
    <div class="text-end">
        <a asp-action="Create" class="btn btn-primary">Add New</a>
    </div>

    <table class="table table-striped">
        <thead>
            <tr>
                <th>Id</th>
                <th>Patient</th>
                <th>Doctor</th>
                <th>Appointment Date</th>
                <th>Status</th>
                <th>Notes</th>
                <th>Action</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var appointment in Model)
            {
                <tr>
                    <td>@appointment.Id</td>
                    <td>@appointment.Patient?.Name</td>
                    <td>@appointment.Doctor?.Name</td>
                    <td>@appointment.AppointmentDate</td>
                    <td>@appointment.Status</td>
                    <td>@appointment.Notes</td>
                    <td>
                        <a asp-action="Edit" asp-route-Id="@appointment.Id" class="btn btn-warning"> Edit  </a>
                        <a asp-action="Delete" asp-route-Id="@appointment.Id" class="btn btn-danger"> Delete  </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
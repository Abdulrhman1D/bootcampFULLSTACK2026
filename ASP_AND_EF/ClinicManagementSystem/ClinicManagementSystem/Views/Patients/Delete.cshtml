@model Patient
@{
    ViewData["Title"] = "Delete Patient";
}


<div class="container">
    <h1>Delete Patients</h1>
    <form asp-action="Delete" method="post">
       
        <div class="form-group">
            <label asp-for="Name" class="control-label"></label>
            <input asp-for="Name" class="form-control" readonly/>
            <span class="text-danger" asp-validation-for="Name"></span>

        </div>
        <div class="form-group">
            <label asp-for="Phone" class="control-label"></label>
            <textarea asp-for="Phone" class="form-control" readonly></textarea>
            <span class="text-danger" asp-validation-for="Phone"></span>
        </div>
        <div class="form-group">
            <label asp-for="Gender" class="control-label"></label>
            <textarea asp-for="Gender" class="form-control" readonly></textarea>
            <span class="text-danger" asp-validation-for="Gender"></span>
        </div>

        

        
        <div class="form-group">
            <input type="submit" value="Delete" class="btn btn-danger" />
        </div>
    </form>
    <div>
        <a asp-action="Index">Back to List</a>
    </div>
</div>
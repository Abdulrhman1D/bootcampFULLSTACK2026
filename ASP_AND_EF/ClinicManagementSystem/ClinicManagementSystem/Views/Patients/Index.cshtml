@model IEnumerable<Patient>
<div class="container">
    <h2>Patients</h2>
    <div class="text-end">
        <a asp-action="Create" class="btn btn-primary">Add New</a>
    </div>
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Id</th>
                <th>Name</th>
                <th>Phone</th>
                <th>DateOfBirth</th>
                <th>Gender</th>
                <th>Action</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var emp in Model)
            {
                <tr>
                    <td>@emp.Id</td>
                    <td>@emp.Name</td>
                    <td>@emp.Phone</td>
                    <td>@emp.DateOfBirth</td>
                    <td>@emp.Gender</td>
                    <td>
                        <a asp-action="Edit" asp-route-Id="@emp.Id" class="btn btn-warning"> Edit  </a>
                        <a asp-action="Delete" asp-route-Id="@emp.Id" class="btn btn-danger"> Delete  </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
@model Doctor
@{
    ViewData["Title"] = "Create Doctor";
}
<div class="container">
    <h1>Create Doctor</h1>
    <form asp-action="Create" method="post">
        <div class="form-group">

            <div class="text-danger" asp-validation-summary="All">
            </div>

            <label class="control-label">Name</label>
            <input asp-for="Name" class="form-control" />
            <label class="control-label">Phone</label>
            <input asp-for="Phone" class="form-control" />
            <label asp-for="SpecialtyId" class="control-label">Specialty</label>

            <select asp-for="SpecialtyId" asp-items="ViewBag.Specialties" class="form-control">
                <option value="">Select Specialty</option>
            </select>
            <span asp-validation-for="SpecialtyId" class="text-danger"></span>
        </div>
        <br />

        <div class="form-group">
            <input type="submit" value="Create" class="btn btn-primary" />
        </div>
    </form>
    <div>
        <a asp-action="Index">Back to List</a>
    </div>
</div>


@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
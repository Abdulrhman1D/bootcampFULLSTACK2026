@model Doctor
@{
    ViewData["Title"] = "Edit Doctor";
}
<div class="container">
    <h1>Edit Doctor</h1>
    <form asp-action="Edit" method="post">

        <div class="text-danger" asp-validation-summary="All">
        </div>
        <div class="form-group">
            <label asp-for="Name" class="control-label"></label>
            <input asp-for="Name" class="form-control" />
            <span class="text-danger" asp-validation-for="Name"></span>

        </div>
        <div class="form-group">
            <label asp-for="Phone" class="control-label"></label>
            <input asp-for="Phone" class="form-control"></input>
            <span class="text-danger" asp-validation-for="Phone"></span>
        </div>
        <div class="form-group">
            <label asp-for="SpecialtyId">Specialty</label>

            <select asp-for="SpecialtyId"asp-items="ViewBag.Specialties"
                    class="form-control">
            </select>

            <span asp-validation-for="SpecialtyId" class="text-danger"></span>
        </div>
        <div class="form-group">
            <input type="submit" value="Update" class="btn btn-warning" />
        </div>
    </form>
    <div>
        <a asp-action="Index">Back to List</a>
    </div>
</div>
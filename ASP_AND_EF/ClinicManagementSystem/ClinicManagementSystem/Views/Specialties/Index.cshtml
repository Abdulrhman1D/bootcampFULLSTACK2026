@model IEnumerable<Specialty>

<div class="container">

    <h2>Specialties</h2>

    <div class="text-end">
        <a asp-action="Create" class="btn btn-primary">Add New</a>
    </div>

    <table class="table table-striped">
        <thead>
            <tr>
                <th>Id</th>
                <th>Name</th>
                <th>Action</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var specialty in Model)
            {
                <tr>
                    <td>@specialty.Id</td>
                    <td>@specialty.Name</td>
                    <td>
                        <a asp-action="Edit" asp-route-Id="@specialty.Id" class="btn btn-warning"> Edit  </a>
                        <a asp-action="Delete" asp-route-Id="@specialty.Id" class="btn btn-danger"> Delete  </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>


@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
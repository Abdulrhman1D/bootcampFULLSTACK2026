@model User

@{
    ViewData["Title"] = "Delete User";
}

<h1>Delete User</h1>

<div class="alert alert-danger">
    Are you sure you want to delete this user?
</div>

<div class="mb-3">
    <strong>Name:</strong>
    @Model.Name
</div>

<div class="mb-3">
    <strong>Username:</strong>
    @Model.UserName
</div>

<div class="mb-3">
    <strong>Email:</strong>
    @Model.Email
</div>


<form asp-action="Delete"
      asp-route-id="@Model.Id"
      method="post">

    <button type="submit"
            class="btn btn-danger">
        Delete
    </button>

    <a asp-action="Index"
       class="btn btn-secondary">
        Cancel
    </a>

</form>
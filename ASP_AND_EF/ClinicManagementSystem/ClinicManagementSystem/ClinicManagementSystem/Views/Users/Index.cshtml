@model IEnumerable<User>

@{
    ViewData["Title"] = "Users";
    int count = 1;
}

<div class="container">
    <h1>Users</h1>

    <div class="text-end">
        <a asp-action="Create" class="btn btn-primary">
            New User
        </a>
    </div>

    <table class="table table-striped">
        <thead>
            <tr>
                <th>Id</th>
                <th>Name</th>
                <th>Username</th>
                <th>Email</th>
                <th>Status</th>
                <th>Actiooonns</th>
            </tr>
        </thead>
           
        <tbody>
            @foreach (var user in Model)
            {
                <tr>
                    <td>@user.Id</td>
                    <td>@user.Name</td>
                    <td>@user.UserName</td>
                    <td>@user.Email</td>
                    <td>
                        @if (user.IsLocked)
                        {
                            <span class="text-danger">Locked</span>
                        }
                        else
                        {
                            <span class="text-success">Active</span>
                        }
                    </td>
                    <td>
                        <a asp-action="Details"
                           asp-route-id="@user.Id"
                           class="btn btn-info">
                            Details
                        </a>

                        <a asp-action="Edit"
                           asp-route-id="@user.Id"
                           class="btn btn-warning">
                            Edit
                        </a>

                        <a asp-action="Delete"
                           asp-route-id="@user.Id"
                           class="btn btn-danger">
                            Delete
                        </a>
                    </td>
                </tr>
                count++;
            }
        </tbody>
    </table>
</div>
